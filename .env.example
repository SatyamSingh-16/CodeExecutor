# ==============================================================================
# Distributed Code Execution Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# DO NOT commit real secrets or credentials into version control.

# Nginx External Port
NGINX_PORT=80

# API Settings
PORT=8080
API_PORT=8080

# PostgreSQL Configuration
POSTGRES_DB=code_execution_db
POSTGRES_USER=code_executor
POSTGRES_PASSWORD=code_executor_dev_secret_change_me
DATABASE_URL=postgres://code_executor:code_executor_dev_secret_change_me@postgres:5432/code_execution_db?sslmode=disable

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_NAME=submissions:stream
REDIS_CONSUMER_GROUP=worker_group

# Worker Pool Configuration
WORKER_CONSUMER_NAME=worker-1
WORKER_CONCURRENCY=4

# JWT Authentication
JWT_SECRET=dev-insecure-jwt-secret-key-minimum-32-chars!
JWT_EXPIRY_HOURS=24

# Rate Limiting (Sliding Window in Redis)
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60
