# HTTP API Configuration
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/code_executor?sslmode=disable
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_bytes
JWT_EXPIRY_HOURS=24
RATE_LIMIT=20
RATE_WINDOW=1m

# Worker & Queue Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
STREAM_NAME=submissions:stream
CONSUMER_GROUP=workers_group
CONSUMER_NAME=worker-1
WORKER_CONCURRENCY=4
POLL_BATCH_SIZE=10
POLL_BLOCK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_SECONDS=30
REAPER_INTERVAL_SECONDS=15
REAPER_MIN_IDLE_SECONDS=30
REAPER_BATCH_SIZE=10
